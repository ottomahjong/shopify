<section
  class="product-feature section-padding{% if section.settings.layout == 'reverse' %} product-feature--reverse{% endif %}"
  data-section-id="{{ section.id }}"
  aria-labelledby="pf-heading-{{ section.id }}"
  style="background-color: {{ section.settings.bg_color | default: 'var(--warm-white)' }};"
>
  <div class="container">
    <div class="product-feature__grid">

      <div class="product-feature__images reveal">
        <div class="product-feature__main-image">
          {%- if section.settings.main_image != blank -%}
            <img
              src="{{ section.settings.main_image | image_url: width: 900 }}"
              alt="{{ section.settings.main_image.alt | default: section.settings.heading }}"
              width="900"
              loading="lazy"
              class="product-feature__img"
            >
          {%- else -%}
            <div class="product-feature__img-placeholder" aria-hidden="true"></div>
          {%- endif -%}
          {%- if section.settings.badge != blank -%}
            <span class="product-feature__badge">{{ section.settings.badge }}</span>
          {%- endif -%}
        </div>

        <div class="product-feature__thumbnails">
          {%- for i in (1..3) -%}
            {%- assign thumb_key = 'thumb_image_' | append: i -%}
            {%- assign thumb = section.settings[thumb_key] -%}
            <button class="product-feature__thumb{% if forloop.first %} product-feature__thumb--active{% endif %}" type="button" aria-label="View image {{ i }}">
              {%- if thumb != blank -%}
                <img
                  src="{{ thumb | image_url: width: 200 }}"
                  alt="{{ thumb.alt | default: section.settings.heading | append: ' — view ' | append: i }}"
                  width="200"
                  loading="lazy"
                >
              {%- else -%}
                <div class="product-feature__thumb-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="product-feature__content reveal">
        {%- if section.settings.heading != blank -%}
          <h2 id="pf-heading-{{ section.id }}" class="product-feature__heading">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="product-feature__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.body_1 != blank -%}
          <p class="product-feature__body">{{ section.settings.body_1 }}</p>
        {%- endif -%}
        {%- if section.settings.body_2 != blank -%}
          <p class="product-feature__body">{{ section.settings.body_2 }}</p>
        {%- endif -%}

        {%- assign has_specs = false -%}
        {%- for i in (1..4) -%}
          {%- assign spec_key_key = 'spec_' | append: i | append: '_key' -%}
          {%- if section.settings[spec_key_key] != blank -%}
            {%- assign has_specs = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_specs -%}
          <dl class="product-feature__specs">
            {%- for i in (1..4) -%}
              {%- assign spec_key_key = 'spec_' | append: i | append: '_key' -%}
              {%- assign spec_val_key = 'spec_' | append: i | append: '_value' -%}
              {%- assign spec_key = section.settings[spec_key_key] -%}
              {%- assign spec_val = section.settings[spec_val_key] -%}
              {%- if spec_key != blank -%}
                <div class="product-feature__spec-row">
                  <dt class="product-feature__spec-key">{{ spec_key }}</dt>
                  <dd class="product-feature__spec-val">{{ spec_val }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if section.settings.price != blank -%}
          <p class="product-feature__price">{{ section.settings.price }}</p>
        {%- endif -%}

        <div class="product-feature__ctas">
          {%- if section.settings.cta_primary_label != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '#' }}"
              class="btn btn--primary"
            >
              {{- section.settings.cta_primary_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url | default: '#' }}"
              class="btn btn--outline"
            >
              {{- section.settings.cta_secondary_label -}}
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Feature",
  "tag": "section",
  "class": "section-product-feature",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main product image"
    },
    {
      "type": "image_picker",
      "id": "thumb_image_1",
      "label": "Thumbnail 1"
    },
    {
      "type": "image_picker",
      "id": "thumb_image_2",
      "label": "Thumbnail 2"
    },
    {
      "type": "image_picker",
      "id": "thumb_image_3",
      "label": "Thumbnail 3"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Image badge",
      "default": "Coming Soon"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Product name (H2)",
      "default": "Vignette"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / tagline",
      "default": "160-Piece American Mahjong Set"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "Vignette is Otto's flagship set — a full 160-piece American Mahjong set built for serious play and serious shelves. Tiles are weighted resin with recessed engraving and paint infill."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "Comes with a walnut-finish hardshell case, tile racks, betting coins, wind markers, and dice. Everything you need. Nothing you don't."
    },
    {
      "type": "header",
      "content": "Specifications"
    },
    {
      "type": "text",
      "id": "spec_1_key",
      "label": "Spec 1 — Label",
      "default": "Tile count"
    },
    {
      "type": "text",
      "id": "spec_1_value",
      "label": "Spec 1 — Value",
      "default": "160 tiles"
    },
    {
      "type": "text",
      "id": "spec_2_key",
      "label": "Spec 2 — Label",
      "default": "Material"
    },
    {
      "type": "text",
      "id": "spec_2_value",
      "label": "Spec 2 — Value",
      "default": "Weighted resin, paint infill"
    },
    {
      "type": "text",
      "id": "spec_3_key",
      "label": "Spec 3 — Label",
      "default": "Case"
    },
    {
      "type": "text",
      "id": "spec_3_value",
      "label": "Spec 3 — Value",
      "default": "Walnut-finish hardshell"
    },
    {
      "type": "text",
      "id": "spec_4_key",
      "label": "Spec 4 — Label",
      "default": "Ships"
    },
    {
      "type": "text",
      "id": "spec_4_value",
      "label": "Spec 4 — Value",
      "default": "Q3 2025"
    },
    {
      "type": "header",
      "content": "Pricing & CTAs"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price display",
      "default": "Pricing TBD — join waitlist for updates"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Join the Waitlist"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "normal", "label": "Image left" },
        { "value": "reverse", "label": "Image right" }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#E8EEF2"
    }
  ],
  "presets": [
    {
      "name": "Product Feature"
    }
  ]
}
{% endschema %}
