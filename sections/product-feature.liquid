<section
  class="product-feature section-padding{% if section.settings.layout == 'reverse' %} product-feature--reverse{% endif %}"
  data-section-id="{{ section.id }}"
  {%- if section.settings.heading != blank %}
    aria-labelledby="pf-heading-{{ section.id }}"
  {%- else %}
    aria-label="Product feature"
  {%- endif %}
  style="background-color: {{ section.settings.bg_color | default: 'var(--warm-white)' }};"
>
  <div class="container">
    <div class="product-feature__grid">

      <div class="product-feature__images reveal">
        <div class="product-feature__main-image">
          {%- if section.settings.main_image != blank -%}
            {{- section.settings.main_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'product-feature__img',
                widths: '600, 900, 1200',
                sizes: '(min-width: 1024px) 50vw, 100vw',
                alt: section.settings.main_image.alt | default: section.settings.heading | default: ''
            -}}
          {%- else -%}
            <div class="product-feature__img-placeholder" aria-hidden="true"></div>
          {%- endif -%}
          {%- if section.settings.badge != blank -%}
            <span class="product-feature__badge">{{ section.settings.badge }}</span>
          {%- endif -%}
        </div>

        <div class="product-feature__thumbnails">
          {%- assign thumb_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'thumbnail' -%}
              {%- assign thumb_index = thumb_index | plus: 1 -%}
              <button
                class="product-feature__thumb{% if thumb_index == 1 %} product-feature__thumb--active{% endif %}"
                type="button"
                aria-label="{{ 'product.view_image' | t: default: 'View image' }} {{ thumb_index }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {{- block.settings.image
                    | image_url: width: 300
                    | image_tag:
                      loading: 'lazy',
                      widths: '100, 200, 300',
                      sizes: '100px',
                      alt: block.settings.image.alt | default: ''
                  -}}
                {%- else -%}
                  <div class="product-feature__thumb-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="product-feature__content reveal">
        {%- if section.settings.heading != blank -%}
          <h2 id="pf-heading-{{ section.id }}" class="product-feature__heading">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="product-feature__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.body_1 != blank -%}
          <p class="product-feature__body">{{ section.settings.body_1 }}</p>
        {%- endif -%}
        {%- if section.settings.body_2 != blank -%}
          <p class="product-feature__body">{{ section.settings.body_2 }}</p>
        {%- endif -%}

        {%- assign spec_blocks = section.blocks | where: 'type', 'spec' -%}
        {%- if spec_blocks.size > 0 -%}
          <dl class="product-feature__specs">
            {%- for block in spec_blocks -%}
              {%- if block.settings.key != blank -%}
                <div class="product-feature__spec-row" {{ block.shopify_attributes }}>
                  <dt class="product-feature__spec-key">{{ block.settings.key }}</dt>
                  <dd class="product-feature__spec-val">{{ block.settings.value }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if section.settings.price != blank -%}
          <p class="product-feature__price">{{ section.settings.price }}</p>
        {%- endif -%}

        <div class="product-feature__ctas">
          {%- if section.settings.cta_primary_label != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '#' }}"
              class="btn btn--primary"
            >
              {{- section.settings.cta_primary_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url | default: '#' }}"
              class="btn btn--outline"
            >
              {{- section.settings.cta_secondary_label -}}
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Feature",
  "tag": "section",
  "class": "section-product-feature",
  "settings": [
    {
      "type": "header",
      "content": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main product image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Image badge",
      "default": "Coming Soon"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Product name (H2)",
      "default": "Vignette"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / tagline",
      "default": "160-Piece American Mahjong Set"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "Vignette is Otto's flagship set — a full 160-piece American Mahjong set built for serious play and serious shelves. Tiles are weighted resin with recessed engraving and paint infill."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "Comes with a walnut-finish hardshell case, tile racks, betting coins, wind markers, and dice. Everything you need. Nothing you don't."
    },
    {
      "type": "header",
      "content": "Pricing & CTAs"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price display",
      "default": "Pricing TBD — join waitlist for updates"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Join the Waitlist"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "normal", "label": "Image left" },
        { "value": "reverse", "label": "Image right" }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#E8EEF2"
    }
  ],
  "blocks": [
    {
      "type": "thumbnail",
      "name": "Thumbnail",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Feature",
      "blocks": [
        { "type": "thumbnail" },
        { "type": "thumbnail" },
        { "type": "thumbnail" },
        {
          "type": "spec",
          "settings": { "key": "Tile count", "value": "160 tiles" }
        },
        {
          "type": "spec",
          "settings": { "key": "Material", "value": "Weighted resin, paint infill" }
        },
        {
          "type": "spec",
          "settings": { "key": "Case", "value": "Walnut-finish hardshell" }
        },
        {
          "type": "spec",
          "settings": { "key": "Ships", "value": "Q3 2025" }
        }
      ]
    }
  ]
}
{% endschema %}
