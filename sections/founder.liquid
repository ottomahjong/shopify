<section
  class="founder section-padding"
  data-section-id="{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="container">
    <div class="founder__layout reveal">

      <div class="founder__content">

        {%- if section.settings.section_label != blank -%}
          <p class="section-label founder__eyebrow" style="color: var(--walnut-on-dark);">
            {{- section.settings.section_label -}}
          </p>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="founder__quote">
            <p><em>{{ section.settings.quote }}</em></p>
          </blockquote>
        {%- endif -%}

        <div class="founder__body">
          {%- if section.settings.body_1 != blank -%}
            <p>{{ section.settings.body_1 }}</p>
          {%- endif -%}
          {%- if section.settings.body_2 != blank -%}
            <p>{{ section.settings.body_2 }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.attribution != blank -%}
          <footer class="founder__attribution">
            <p class="founder__attribution-text">{{ section.settings.attribution }}</p>
          </footer>
        {%- endif -%}

      </div>

      {%- if section.settings.founder_image != blank -%}
        <div class="founder__image-wrap">
          <img
            src="{{ section.settings.founder_image | image_url: width: 600 }}"
            alt="{{ section.settings.founder_image.alt | default: section.settings.attribution }}"
            width="300"
            loading="lazy"
            class="founder__image"
          >
        </div>
      {%- else -%}
        <div class="founder__image-wrap founder__image-wrap--placeholder" aria-hidden="true"></div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Quote",
  "tag": "section",
  "class": "section-founder",
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (eyebrow)",
      "default": "Why Otto Exists"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Pull quote (italic)",
      "default": "Mahjong does what almost nothing else does — it blocks the outside world. Not by demanding you ignore it, but by requiring so much of you that there's simply no room left for it."
    },
    {
      "type": "header",
      "content": "Body"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "I came to Mahjong late. My sister taught me, sitting across a table that had been in her house for years. Within twenty minutes I understood why. The game is cognitively demanding in the best way — pattern recognition, flexible strategy, constrained creativity. It mirrors how I think when I'm designing."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "What I couldn't find was a set that matched that feeling. Or the room. Or the people in it. The sets that existed were beautiful, but they weren't built for my home, my partner, or the way I actually wanted to use them. Otto is the set I wanted to buy and couldn't: every component designed together, as one object. Calm. Considered. Built to stay on the table."
    },
    {
      "type": "header",
      "content": "Attribution"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution line",
      "default": "Kelly Phillips · Founder, Otto Mahjong"
    },
    {
      "type": "header",
      "content": "Founder Image"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder photo (optional, circular crop)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1A2137"
    }
  ],
  "presets": [
    {
      "name": "Founder Quote"
    }
  ]
}
{% endschema %}
