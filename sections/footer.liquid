<footer
  class="site-footer"
  data-section-id="{{ section.id }}"
  {%- if section.settings.bg_color != blank %}
    style="background-color: {{ section.settings.bg_color }};"
  {%- endif %}
>
  <div class="site-footer__inner container">

    <div class="site-footer__top">

      {%- comment -%} BRAND COLUMN {%- endcomment -%}
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="site-footer__logo-link" aria-label="{{ shop.name }}">
          <span class="site-footer__wordmark">OTTO</span>
        </a>

        <div class="site-footer__emblem" aria-hidden="true">
          {%- if section.settings.logo_image != blank -%}
            {{- section.settings.logo_image
              | image_url: width: 80
              | image_tag:
                loading: 'lazy',
                class: 'site-footer__emblem-img',
                width: 40,
                alt: ''
            -}}
          {%- else -%}
            {% render 'icon-sprite', icon: 'otto-logo' %}
          {%- endif -%}
        </div>

        {%- if section.settings.tagline != blank -%}
          <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a
              href="{{ settings.social_instagram }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              {% render 'icon-sprite', icon: 'instagram' %}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a
              href="{{ settings.social_facebook }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              {% render 'icon-sprite', icon: 'facebook' %}
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a
              href="{{ settings.social_pinterest }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
            >
              {% render 'icon-sprite', icon: 'pinterest' %}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a
              href="{{ settings.social_tiktok }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
            >
              {% render 'icon-sprite', icon: 'tiktok' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} NAV COLUMNS {%- endcomment -%}
      <nav class="site-footer__nav" aria-label="Footer navigation">
        {%- for col in (1..3) -%}
          {%- assign col_menu_key = 'col_' | append: col | append: '_menu' -%}
          {%- assign col_title_key = 'col_' | append: col | append: '_title' -%}
          {%- assign col_menu_handle = section.settings[col_menu_key] -%}
          {%- if col_menu_handle != blank -%}
            {%- assign col_linklist = linklists[col_menu_handle] -%}
            {%- if col_linklist.links.size > 0 -%}
              <div class="site-footer__nav-col">
                <h3 class="site-footer__nav-title">
                  {{- section.settings[col_title_key] | default: col_linklist.title -}}
                </h3>
                <ul class="site-footer__nav-list" role="list">
                  {%- for link in col_linklist.links -%}
                    <li>
                      <a href="{{ link.url }}" class="site-footer__nav-link">
                        {{- link.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>

      {%- comment -%} NEWSLETTER {%- endcomment -%}
      <div class="site-footer__newsletter">
        {%- if section.settings.newsletter_title != blank -%}
          <p class="site-footer__newsletter-title">
            {{- section.settings.newsletter_title -}}
          </p>
        {%- endif -%}
        {%- form 'customer', id: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <label for="footer-email" class="sr-only">
              {{ 'general.email' | t: default: 'Email address' }}
            </label>
            <input
              type="email"
              id="footer-email"
              name="contact[email]"
              class="site-footer__newsletter-input"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="site-footer__newsletter-btn btn btn--primary">
              {{- section.settings.newsletter_submit -}}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="site-footer__newsletter-success" role="status">
              {{- section.settings.newsletter_success -}}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    <div class="site-footer__bottom">
      {%- if section.settings.copyright_text != blank -%}
        <p class="site-footer__copyright">
          {{- section.settings.copyright_text -}}
        </p>
      {%- endif -%}
      <nav class="site-footer__legal" aria-label="Legal navigation">
        {%- if shop.privacy_policy != blank -%}
          <a href="{{ shop.privacy_policy.url }}" class="site-footer__legal-link">
            {{- 'footer.privacy_policy' | t -}}
          </a>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <a href="{{ shop.terms_of_service.url }}" class="site-footer__legal-link">
            {{- 'footer.terms_of_service' | t -}}
          </a>
        {%- endif -%}
        {%- if shop.refund_policy != blank -%}
          <a href="{{ shop.refund_policy.url }}" class="site-footer__legal-link">
            {{- 'footer.refund_policy' | t -}}
          </a>
        {%- endif -%}
        {%- if shop.shipping_policy != blank -%}
          <a href="{{ shop.shipping_policy.url }}" class="site-footer__legal-link">
            {{- 'footer.shipping_policy' | t -}}
          </a>
        {%- endif -%}
      </nav>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand Column"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo / emblem image (optional, max 40px tall)"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "One table. Three others."
    },
    {
      "type": "header",
      "content": "Navigation Columns"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 title override",
      "info": "Leave blank to use the menu name."
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 menu (optional)"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 title override",
      "info": "Leave blank to use the menu name."
    },
    {
      "type": "link_list",
      "id": "col_3_menu",
      "label": "Column 3 menu (optional)"
    },
    {
      "type": "text",
      "id": "col_3_title",
      "label": "Column 3 title override",
      "info": "Leave blank to use the menu name."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_submit",
      "label": "Submit button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "You're on the list."
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 Otto Mahjong. All rights reserved."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1A2137"
    }
  ]
}
{% endschema %}
