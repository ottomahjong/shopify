<footer class="site-footer" data-section-id="{{ section.id }}" style="background-color: var(--night);">
  <div class="site-footer__inner container">

    <div class="site-footer__top">

      {%- comment -%} BRAND COLUMN {%- endcomment -%}
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="site-footer__logo-link" aria-label="{{ shop.name }}">
          <span class="site-footer__wordmark">OTTO</span>
        </a>

        <div class="site-footer__emblem" aria-hidden="true">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 80 }}"
              alt=""
              width="40"
              loading="lazy"
              class="site-footer__emblem-img"
            >
          {%- else -%}
            {% render 'icon-sprite', icon: 'otto-logo' %}
          {%- endif -%}
        </div>

        {%- if section.settings.tagline != blank -%}
          <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a
              href="{{ settings.social_instagram }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              {% render 'icon-sprite', icon: 'instagram' %}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a
              href="{{ settings.social_facebook }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              {% render 'icon-sprite', icon: 'facebook' %}
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a
              href="{{ settings.social_pinterest }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
            >
              {% render 'icon-sprite', icon: 'pinterest' %}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a
              href="{{ settings.social_tiktok }}"
              class="site-footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
            >
              {% render 'icon-sprite', icon: 'tiktok' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} NAV COLUMNS {%- endcomment -%}
      <nav class="site-footer__nav" aria-label="Footer navigation">
        {%- for col in (1..3) -%}
          {%- assign col_title_key = 'col_' | append: col | append: '_title' -%}
          {%- assign col_title = section.settings[col_title_key] -%}
          {%- if col_title != blank -%}
            <div class="site-footer__nav-col">
              <h3 class="site-footer__nav-title">{{ col_title }}</h3>
              <ul class="site-footer__nav-list" role="list">
                {%- for i in (1..6) -%}
                  {%- assign link_label_key = 'col_' | append: col | append: '_link_' | append: i | append: '_label' -%}
                  {%- assign link_url_key   = 'col_' | append: col | append: '_link_' | append: i | append: '_url' -%}
                  {%- assign link_label = section.settings[link_label_key] -%}
                  {%- assign link_url   = section.settings[link_url_key] -%}
                  {%- if link_label != blank -%}
                    <li>
                      <a href="{{ link_url | default: '#' }}" class="site-footer__nav-link">
                        {{- link_label -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      {%- comment -%} NEWSLETTER {%- endcomment -%}
      <div class="site-footer__newsletter">
        <p class="site-footer__newsletter-title">
          {{- section.settings.newsletter_title -}}
        </p>
        {%- form 'customer', id: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <label for="footer-email" class="sr-only">
              Email address
            </label>
            <input
              type="email"
              id="footer-email"
              name="contact[email]"
              class="site-footer__newsletter-input"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="site-footer__newsletter-btn btn btn--primary">
              {{- section.settings.newsletter_submit -}}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="site-footer__newsletter-success" role="status">
              You're on the list.
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        {{- section.settings.copyright_text -}}
      </p>
      <nav class="site-footer__legal" aria-label="Legal navigation">
        {%- if shop.privacy_policy != blank -%}
          <a href="{{ shop.privacy_policy.url }}" class="site-footer__legal-link">
            {{- 'footer.privacy_policy' | t -}}
          </a>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <a href="{{ shop.terms_of_service.url }}" class="site-footer__legal-link">
            {{- 'footer.terms_of_service' | t -}}
          </a>
        {%- endif -%}
        {%- if shop.refund_policy != blank -%}
          <a href="{{ shop.refund_policy.url }}" class="site-footer__legal-link">
            {{- 'footer.refund_policy' | t -}}
          </a>
        {%- endif -%}
        {%- if shop.shipping_policy != blank -%}
          <a href="{{ shop.shipping_policy.url }}" class="site-footer__legal-link">
            {{- 'footer.shipping_policy' | t -}}
          </a>
        {%- endif -%}
      </nav>
    </div>

  </div>
</footer>

