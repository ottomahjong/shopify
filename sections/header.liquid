<header
  class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}"
  data-section-id="{{ section.id }}"
  style="--header-bg-opacity: {{ section.settings.bg_opacity | divided_by: 100.0 }}; background-color: rgba(250,248,244,var(--header-bg-opacity)); backdrop-filter: blur(4px);"
>
  <div class="site-header__inner container">

    {%- comment -%} LOGO {%- endcomment -%}
    <a
      href="{{ routes.root_url }}"
      class="site-header__logo"
      aria-label="{{ section.settings.logo_alt | default: shop.name }}"
    >
      {%- if section.settings.logo_image != blank -%}
        {%- assign logo_2x = section.settings.logo_width | times: 2 -%}
        {{- section.settings.logo_image
          | image_url: width: logo_2x
          | image_tag:
            loading: 'eager',
            class: 'site-header__logo-img',
            width: section.settings.logo_width,
            alt: section.settings.logo_alt | default: shop.name
        -}}
      {%- else -%}
        <span class="header-logo-text">OTTO</span>
      {%- endif -%}
    </a>

    {%- comment -%} DESKTOP NAV {%- endcomment -%}
    {%- assign nav_links = linklists[section.settings.nav_menu].links -%}
    {%- if nav_links.size > 0 -%}
      <nav class="site-header__nav" aria-label="{{ 'navigation.main' | t: default: 'Main navigation' }}">
        <ul class="site-header__nav-list" role="list">
          {%- for link in nav_links -%}
            <li class="site-header__nav-item">
              <a
                href="{{ link.url }}"
                class="site-header__nav-link"
                {%- if link.active %} aria-current="page"{% endif -%}
              >
                {{- link.title -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- comment -%} ACTIONS {%- endcomment -%}
    <div class="site-header__actions">
      {%- if section.settings.cta_label != blank -%}
        <a
          href="{{ section.settings.cta_url | default: '#waitlist' }}"
          class="site-header__cta btn btn--primary"
        >
          {{- section.settings.cta_label -}}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="site-header__cart"
        aria-label="{{ 'cart.title' | t }} ({{ cart.item_count }})"
      >
        <span class="site-header__cart-icon" aria-hidden="true">
          {% render 'icon-sprite', icon: 'cart' %}
        </span>
        <span class="site-header__cart-count" data-cart-count>
          {{- cart.item_count -}}
        </span>
      </a>

      <button
        class="site-header__hamburger"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="{{ 'navigation.open_menu' | t }}"
        type="button"
        data-nav-toggle
      >
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
      </button>
    </div>
  </div>

  {%- comment -%} MOBILE NAV {%- endcomment -%}
  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label="{{ 'navigation.mobile' | t: default: 'Mobile navigation' }}"
    hidden
  >
    <ul class="mobile-nav__list" role="list">
      {%- for link in nav_links -%}
        <li class="mobile-nav__item">
          <a
            href="{{ link.url }}"
            class="mobile-nav__link"
            {%- if link.active %} aria-current="page"{% endif -%}
          >
            {{- link.title -}}
          </a>
        </li>
      {%- endfor -%}
      {%- if section.settings.cta_label != blank -%}
        <li class="mobile-nav__item mobile-nav__item--cta">
          <a
            href="{{ section.settings.cta_url | default: '#waitlist' }}"
            class="btn btn--primary"
          >
            {{- section.settings.cta_label -}}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Leave blank to display the text wordmark \"OTTO\"."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo display width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Otto Mahjong",
      "info": "Describes the logo for screen readers."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "nav_menu",
      "label": "Navigation menu",
      "default": "main-menu",
      "info": "Manage links in the Shopify Navigation admin."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Join Waitlist"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL",
      "info": "Leave blank to default to /#waitlist."
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity when scrolled",
      "min": 70,
      "max": 100,
      "step": 5,
      "default": 95,
      "unit": "%"
    }
  ]
}
{% endschema %}
