<section
  class="product-grid section-padding"
  data-section-id="{{ section.id }}"
  aria-labelledby="product-grid-heading-{{ section.id }}"
>
  <div class="container">

    <div class="product-grid__header reveal">
      {%- if section.settings.section_label != blank -%}
        <p class="section-label">{{ section.settings.section_label }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="product-grid-heading-{{ section.id }}" class="product-grid__heading">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <p class="product-grid__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="product-grid__grid reveal-stagger">
      {%- for i in (1..4) -%}
        {%- assign card_image_key = 'card_' | append: i | append: '_image' -%}
        {%- assign card_title_key = 'card_' | append: i | append: '_title' -%}
        {%- assign card_desc_key = 'card_' | append: i | append: '_desc' -%}
        {%- assign card_price_key = 'card_' | append: i | append: '_price' -%}
        {%- assign card_badge_key = 'card_' | append: i | append: '_badge' -%}
        {%- assign card_cta_label_key = 'card_' | append: i | append: '_cta_label' -%}
        {%- assign card_cta_url_key = 'card_' | append: i | append: '_cta_url' -%}

        {%- assign card_image = section.settings[card_image_key] -%}
        {%- assign card_title = section.settings[card_title_key] -%}
        {%- assign card_desc = section.settings[card_desc_key] -%}
        {%- assign card_price = section.settings[card_price_key] -%}
        {%- assign card_badge = section.settings[card_badge_key] -%}
        {%- assign card_cta_label = section.settings[card_cta_label_key] -%}
        {%- assign card_cta_url = section.settings[card_cta_url_key] -%}

        {%- if card_title != blank -%}
          <article class="product-card">
            <div class="product-card__image-wrap">
              {%- if card_image != blank -%}
                <img
                  src="{{ card_image | image_url: width: 600 }}"
                  alt="{{ card_image.alt | default: card_title }}"
                  width="600"
                  loading="lazy"
                  class="product-card__image"
                >
              {%- else -%}
                <div class="product-card__image-placeholder" aria-hidden="true"></div>
              {%- endif -%}

              {%- if card_badge != blank -%}
                <span class="product-card__badge">{{ card_badge }}</span>
              {%- endif -%}
            </div>

            <div class="product-card__body">
              <h3 class="product-card__title">{{ card_title }}</h3>
              {%- if card_desc != blank -%}
                <p class="product-card__desc">{{ card_desc }}</p>
              {%- endif -%}
              {%- if card_price != blank -%}
                <p class="product-card__price">{{ card_price }}</p>
              {%- else -%}
                <p class="product-card__price product-card__price--tbd">
                  {{- 'product.pricing_tbd' | t -}}
                </p>
              {%- endif -%}
            </div>

            {%- if card_cta_label != blank -%}
              <a
                href="{{ card_cta_url | default: '#' }}"
                class="product-card__cta btn btn--outline"
              >
                {{- card_cta_label -}}
              </a>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

