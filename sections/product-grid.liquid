<section
  class="product-grid section-padding"
  data-section-id="{{ section.id }}"
  aria-labelledby="product-grid-heading-{{ section.id }}"
  style="background-color: {{ section.settings.bg_color | default: 'var(--warm-white)' }};"
>
  <div class="container">

    <div class="product-grid__header reveal">
      {%- if section.settings.section_label != blank -%}
        <p class="section-label">{{ section.settings.section_label }}</p>
      {%- endif -%}

      <h2 id="product-grid-heading-{{ section.id }}" class="product-grid__heading">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_italic != blank -%}
          <br><em>{{ section.settings.heading_italic }}</em>
        {%- endif -%}
      </h2>

      {%- if section.settings.intro != blank -%}
        <p class="product-grid__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="product-grid__grid reveal-stagger">
      {%- for block in section.blocks -%}
        {%- if block.settings.name != blank -%}
          <article
            class="product-card"
            aria-label="{{ block.settings.name }}"
            {{ block.shopify_attributes }}
          >
            <div class="product-card__image-wrap">
              {%- if block.settings.image != blank -%}
                {{- block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'product-card__image',
                    widths: '400, 600, 800',
                    sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw',
                    alt: block.settings.image.alt | default: block.settings.name | default: ''
                -}}
              {%- else -%}
                <div class="product-card__image-placeholder" aria-hidden="true"></div>
              {%- endif -%}

              {%- if block.settings.badge != blank -%}
                <span class="product-card__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </div>

            <div class="product-card__body">
              <h3 class="product-card__title">{{ block.settings.name }}</h3>
              {%- if block.settings.desc != blank -%}
                <p class="product-card__desc">{{ block.settings.desc }}</p>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <p class="product-card__price">{{ block.settings.price }}</p>
              {%- else -%}
                <p class="product-card__price product-card__price--tbd">
                  {{- 'product.pricing_tbd' | t -}}
                </p>
              {%- endif -%}
            </div>

            {%- if block.settings.cta_label != blank -%}
              <a
                href="{{ block.settings.cta_url | default: '/#waitlist' }}"
                class="product-card__cta btn btn--outline"
              >
                {{- block.settings.cta_label -}}
              </a>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (eyebrow)",
      "default": "The Collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (Futura)",
      "default": "Everything at the table."
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic line (Cormorant, appended)",
      "default": "Nothing out of place."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "Every Otto component is designed as part of a single system. The tile palette matches the mat. The racks complement the tiles. The whole set speaks one visual language — because it was designed in one conversation, not assembled from separate sources."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#faf8f4"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (leave blank for 'Pricing TBD')"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Coming Soon"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Join Waitlist"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "name": "Vignette",
            "desc": "Bone and indigo bodies. Copper base. Recessed engraving with paint infill — not flat UV printing. Designed to be picked up dozens of times per game. Built to feel like it.",
            "price": "$300 – $400",
            "badge": "Coming Soon",
            "cta_label": "Join Waitlist"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "The Mat",
            "desc": "Cushioned, non-slip, sized for four. Designed in the same palette as the tile set — not sourced to match, but designed alongside. Rolled and stored in a mat sleeve.",
            "price": "$60 – $70",
            "badge": "Coming Soon",
            "cta_label": "Join Waitlist"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "The Racks",
            "desc": "Designed as furniture, not accessories. Solid walnut, satin oil finish. The rack is the object you touch every single turn. It should feel like it belongs in the room.",
            "badge": "Coming Soon",
            "cta_label": "Join Waitlist"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "Reference Cards",
            "desc": "One per player. Double-sided: in-game rules on one side, NMJL card decoder on the other. Designed to answer the question mid-game — not after it.",
            "badge": "Coming Soon",
            "cta_label": "Join Waitlist"
          }
        }
      ]
    }
  ]
}
{% endschema %}
