<div class="page-404" data-section-id="{{ section.id }}">
  <div class="page-404__inner">
    <p class="page-404__number" aria-hidden="true">404</p>
    <h1 class="page-404__heading">
      {{ section.settings.heading | default: "Page not found" }}
    </h1>
    <p class="page-404__body">
      {{ section.settings.body | default: "The page you're looking for has moved, or doesn't exist. Let's get you back on track." }}
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="{{ routes.root_url }}" class="btn btn--primary">
        {{ section.settings.home_label | default: 'Go Home' }}
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost">
        {{ section.settings.shop_label | default: 'View Products' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 — Main",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "The page you're looking for has moved, or doesn't exist. Let's get you back on track."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home button label",
      "default": "Go Home"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "View Products"
    }
  ]
}
{% endschema %}
