<section
  class="hero-split"
  data-section-id="{{ section.id }}"
  aria-labelledby="hero-heading-{{ section.id }}"
>
  <div class="hero-split__grid">

    {%- comment -%} LEFT PANEL — dark navy {%- endcomment -%}
    <div class="hero-split__left" style="background-color: {{ section.settings.left_bg }};">
      <div class="hero-split__left-inner">

        {%- if section.settings.eyebrow != blank -%}
          <p class="section-label hero-split__eyebrow">
            {{- section.settings.eyebrow -}}
          </p>
        {%- endif -%}

        <h1 id="hero-heading-{{ section.id }}" class="hero-split__heading">
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="hero-split__heading-line">{{ section.settings.heading_line_1 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="hero-split__heading-line">{{ section.settings.heading_line_2 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_3 != blank -%}
            <em class="hero-split__heading-line hero-split__heading-line--serif">{{ section.settings.heading_line_3 }}</em>
          {%- endif -%}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="hero-split__subhead">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}

        {%- if section.settings.brand_line != blank -%}
          <p class="hero-split__brand-line">
            {{- section.settings.brand_line -}}
          </p>
        {%- endif -%}

        {%- if section.settings.waitlist_prompt != blank -%}
          <p class="hero-split__waitlist-prompt">
            {{- section.settings.waitlist_prompt -}}
          </p>
        {%- endif -%}

        {% render 'waitlist-form',
          section_id: section.id,
          placeholder: section.settings.email_placeholder,
          button_label: section.settings.button_label,
          dark: true
        %}

      </div>
    </div>

    {%- comment -%} RIGHT PANEL — warm white with tile grid {%- endcomment -%}
    <div
      class="hero-split__right"
      style="background-color: {{ section.settings.right_bg }};"
    >
      <div class="hero-split__tile-grid">
        {%- for i in (1..8) -%}
          {%- assign tile_key = 'tile_image_' | append: i -%}
          {%- assign tile_image = section.settings[tile_key] -%}
          <div class="hero-split__tile">
            {%- if tile_image != blank -%}
              <img
                src="{{ tile_image | image_url: width: 400 }}"
                alt="{{ tile_image.alt | default: 'Otto Mahjong tile' }}"
                width="400"
                loading="{% if i <= 2 %}eager{% else %}lazy{% endif %}"
                class="hero-split__tile-img"
              >
            {%- else -%}
              <div class="hero-split__tile-placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="hero-split__right-form">
        {%- if section.settings.waitlist_prompt != blank -%}
          <p class="hero-split__right-form-label">
            {{- section.settings.waitlist_prompt | upcase -}}
          </p>
        {%- endif -%}
        {% render 'waitlist-form',
          section_id: section.id | append: '-right',
          placeholder: section.settings.email_placeholder,
          button_label: section.settings.button_label,
          dark: false
        %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero — Split",
  "tag": "section",
  "class": "section-hero-split",
  "settings": [
    {
      "type": "header",
      "content": "Left Panel — Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "American Mahjong · A Considered Set"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1 (Futura, bold)",
      "default": "Four people."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (Futura, bold)",
      "default": "One table."
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3 (Cormorant, italic)",
      "default": "Nothing else."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading paragraph",
      "default": "Otto is a design-forward American Mahjong set built for people who care about what sits on their shelves — and everyone at their table. Every component designed together, as one system."
    },
    {
      "type": "text",
      "id": "brand_line",
      "label": "Brand meaning line",
      "default": "Otto — One Table. Three Others."
    },
    {
      "type": "text",
      "id": "waitlist_prompt",
      "label": "Waitlist prompt",
      "default": "Be first to the table."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Form button label",
      "default": "Join Waitlist"
    },
    {
      "type": "color",
      "id": "left_bg",
      "label": "Left panel background",
      "default": "#1A2137"
    },
    {
      "type": "header",
      "content": "Right Panel — Tile Grid"
    },
    {
      "type": "color",
      "id": "right_bg",
      "label": "Right panel background",
      "default": "#E8EEF2"
    },
    {
      "type": "image_picker",
      "id": "tile_image_1",
      "label": "Tile image 1"
    },
    {
      "type": "image_picker",
      "id": "tile_image_2",
      "label": "Tile image 2"
    },
    {
      "type": "image_picker",
      "id": "tile_image_3",
      "label": "Tile image 3"
    },
    {
      "type": "image_picker",
      "id": "tile_image_4",
      "label": "Tile image 4"
    },
    {
      "type": "image_picker",
      "id": "tile_image_5",
      "label": "Tile image 5"
    },
    {
      "type": "image_picker",
      "id": "tile_image_6",
      "label": "Tile image 6"
    },
    {
      "type": "image_picker",
      "id": "tile_image_7",
      "label": "Tile image 7"
    },
    {
      "type": "image_picker",
      "id": "tile_image_8",
      "label": "Tile image 8"
    }
  ],
  "presets": [
    {
      "name": "Hero — Split"
    }
  ]
}
{% endschema %}
