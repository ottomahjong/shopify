<section
  class="hero-split"
  data-section-id="{{ section.id }}"
  aria-labelledby="hero-heading-{{ section.id }}"
>
  <div class="hero-split__grid">

    {%- comment -%} LEFT PANEL {%- endcomment -%}
    <div
      class="hero-split__left"
      {%- if section.settings.left_bg != blank %}
        style="background-color: {{ section.settings.left_bg }};"
      {%- endif %}
    >
      <div class="hero-split__left-inner">

        {%- if section.settings.eyebrow != blank -%}
          <p class="section-label hero-split__eyebrow">
            {{- section.settings.eyebrow -}}
          </p>
        {%- endif -%}

        <h1 id="hero-heading-{{ section.id }}" class="hero-split__heading">
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="hero-split__heading-line">
              {{- section.settings.heading_line_1 -}}
            </span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="hero-split__heading-line">
              {{- section.settings.heading_line_2 -}}
            </span>
          {%- endif -%}
          {%- if section.settings.heading_line_3 != blank -%}
            <em class="hero-split__heading-line hero-split__heading-line--serif">
              {{- section.settings.heading_line_3 -}}
            </em>
          {%- endif -%}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="hero-split__subhead">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}

        {%- if section.settings.brand_line != blank -%}
          <p class="hero-split__brand-line">
            {{- section.settings.brand_line -}}
          </p>
        {%- endif -%}

        {%- if section.settings.waitlist_prompt != blank -%}
          <p class="hero-split__waitlist-prompt">
            {{- section.settings.waitlist_prompt -}}
          </p>
        {%- endif -%}

        {% render 'waitlist-form',
          section_id: section.id,
          placeholder: section.settings.email_placeholder,
          button_label: section.settings.button_label,
          dark: true
        %}

      </div>
    </div>

    {%- comment -%} RIGHT PANEL — tile grid {%- endcomment -%}
    <div
      class="hero-split__right"
      {%- if section.settings.right_bg != blank %}
        style="background-color: {{ section.settings.right_bg }};"
      {%- endif %}
    >
      <div class="hero-split__tile-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            {%- assign tile_loading = 'lazy' -%}
            {%- if forloop.index <= 2 -%}
              {%- assign tile_loading = 'eager' -%}
            {%- endif -%}
            <div class="hero-split__tile" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{- block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: tile_loading,
                    class: 'hero-split__tile-img',
                    widths: '200, 400, 600',
                    width: 300,
                    alt: block.settings.alt | default: block.settings.image.alt | default: ''
                -}}
              {%- else -%}
                <div class="hero-split__tile-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="hero-split__right-form">
        {%- if section.settings.waitlist_prompt != blank -%}
          <p class="hero-split__right-form-label">
            {{- section.settings.waitlist_prompt -}}
          </p>
        {%- endif -%}
        {% render 'waitlist-form',
          section_id: section.id | append: '-right',
          placeholder: section.settings.email_placeholder,
          button_label: section.settings.button_label,
          dark: false
        %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero — Split",
  "tag": "section",
  "class": "section-hero-split",
  "settings": [
    {
      "type": "header",
      "content": "Left Panel — Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "American Mahjong · A Considered Set"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1 (Futura, bold)",
      "default": "Four people."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (Futura, bold)",
      "default": "One table."
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3 (Cormorant, italic)",
      "default": "Nothing else."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Otto is a design-forward American Mahjong set built for people who care about what sits on their shelves — and everyone at their table. Every component designed together, as one system."
    },
    {
      "type": "text",
      "id": "brand_line",
      "label": "Brand line",
      "default": "Otto — One Table. Three Others."
    },
    {
      "type": "header",
      "content": "Waitlist Form"
    },
    {
      "type": "text",
      "id": "waitlist_prompt",
      "label": "Prompt above form",
      "default": "Be first to the table."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Join Waitlist"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "left_bg",
      "label": "Left panel background",
      "default": "#1A2137"
    },
    {
      "type": "color",
      "id": "right_bg",
      "label": "Right panel background",
      "default": "#E8EEF2"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Describes the image for screen readers. Leave blank to use the image's built-in alt text."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero — Split",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
