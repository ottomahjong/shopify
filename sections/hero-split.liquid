<section
  class="hero-split"
  id="hero"
  data-section-id="{{ section.id }}"
  aria-labelledby="hero-heading-{{ section.id }}"
>

  {%- comment -%} DEPTH 0: Background atmosphere (aria-hidden) {%- endcomment -%}
  <div class="layer depth-0" data-depth="0" aria-hidden="true">
    <div class="hero-bg-glow"></div>
  </div>

  <div class="hero-split__grid">

    {%- comment -%} LEFT PANEL: depth-4 text, depth-3 form {%- endcomment -%}
    <div
      class="hero-split__left"
      data-depth="4"
      {%- if section.settings.left_bg != blank %}
        style="background-color: {{ section.settings.left_bg }};"
      {%- endif %}
    >
      <div class="hero-split__left-inner">

        {%- if section.settings.eyebrow != blank -%}
          <p class="section-label hero-split__eyebrow">
            {{- section.settings.eyebrow -}}
          </p>
        {%- endif -%}

        <h1 id="hero-heading-{{ section.id }}" class="hero-split__heading">
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="hero-split__heading-line">
              {{- section.settings.heading_line_1 -}}
            </span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="hero-split__heading-line">
              {{- section.settings.heading_line_2 -}}
            </span>
          {%- endif -%}
          {%- if section.settings.heading_line_3 != blank -%}
            <em class="hero-split__heading-line hero-split__heading-line--serif">
              {{- section.settings.heading_line_3 -}}
            </em>
          {%- endif -%}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="hero-split__subhead">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}

        {%- if section.settings.brand_line != blank -%}
          <p class="hero-split__brand-line">
            {{- section.settings.brand_line -}}
          </p>
        {%- endif -%}

        {%- if section.settings.waitlist_prompt != blank -%}
          <p class="hero-split__waitlist-prompt">
            {{- section.settings.waitlist_prompt -}}
          </p>
        {%- endif -%}

        <div data-depth="3">
          {% render 'waitlist-form',
            section_id: section.id,
            placeholder: section.settings.email_placeholder,
            button_label: section.settings.button_label,
            dark: true
          %}
        </div>

      </div>
    </div>

    {%- comment -%} RIGHT PANEL: depth-3 tile grid (aria-hidden — decorative) {%- endcomment -%}
    <div
      class="hero-split__right"
      data-depth="3"
      aria-hidden="true"
      {%- if section.settings.right_bg != blank %}
        style="background-color: {{ section.settings.right_bg }};"
      {%- endif %}
    >

      {%- comment -%} TILE GRID: 4×2, 8 image slots {%- endcomment -%}
      <div class="hero-tile-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            {%- assign tile_index = forloop.index -%}
            {%- assign tile_class = 'hero-tile' -%}
            {%- if tile_index == 3 -%}{%- assign tile_class = 'hero-tile hero-tile--walnut' -%}{%- endif -%}
            {%- if tile_index == 5 -%}{%- assign tile_class = 'hero-tile hero-tile--walnut-light' -%}{%- endif -%}
            {%- if tile_index == 2 or tile_index == 6 -%}{%- assign tile_class = 'hero-tile hero-tile--warm' -%}{%- endif -%}

            <div class="{{ tile_class }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{- block.settings.image
                  | image_url: width: 300
                  | image_tag:
                    loading: 'eager',
                    class: 'hero-tile__img',
                    width: 300,
                    height: 300,
                    alt: ''
                -}}
              {%- else -%}
                <div
                  class="img-placeholder img-placeholder--tile img-placeholder--dark"
                  data-label="Tile {{ tile_index }}"
                  aria-hidden="true">
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="hero-split__right-form">
        {%- if section.settings.waitlist_prompt != blank -%}
          <p class="hero-split__right-form-label">
            {{- section.settings.waitlist_prompt -}}
          </p>
        {%- endif -%}
        {% render 'waitlist-form',
          section_id: section.id | append: '-right',
          placeholder: section.settings.email_placeholder,
          button_label: section.settings.button_label,
          dark: false
        %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero — Split",
  "tag": "section",
  "class": "section-hero-split",
  "settings": [
    {
      "type": "header",
      "content": "Left Panel — Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "American Mahjong · A Considered Set"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1 (Futura, bold)",
      "default": "Four people."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (Futura, bold)",
      "default": "One table."
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3 (Cormorant, italic)",
      "default": "Nothing else."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Otto is a design-forward American Mahjong set built for people who care about what sits on their shelves — and everyone at their table. Every component designed together, as one system."
    },
    {
      "type": "text",
      "id": "brand_line",
      "label": "Brand line",
      "default": "Otto — One Table. Three Others."
    },
    {
      "type": "header",
      "content": "Waitlist Form"
    },
    {
      "type": "text",
      "id": "waitlist_prompt",
      "label": "Prompt above form",
      "default": "Be first to the table."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Join Waitlist"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "left_bg",
      "label": "Left panel background",
      "default": "#1A2137"
    },
    {
      "type": "color",
      "id": "right_bg",
      "label": "Right panel background",
      "default": "#E8EEF2"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Describe the image for accessibility. Leave blank if decorative."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero — Split",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
