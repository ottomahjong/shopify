<section
  class="faq-accordion"
  data-section-id="{{ section.id }}"
  {%- if section.settings.heading != blank %}
    aria-labelledby="faq-heading-{{ section.id }}"
  {%- else %}
    aria-label="Frequently asked questions"
  {%- endif %}
  {%- if section.settings.bg_color != blank %}
    style="background-color: {{ section.settings.bg_color }};"
  {%- endif %}
>
  <div class="container">

    {%- if section.settings.section_label != blank or section.settings.heading != blank -%}
      <div class="faq-accordion__left">
        {%- if section.settings.section_label != blank -%}
          <p class="section-label">{{ section.settings.section_label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="faq-heading-{{ section.id }}" class="faq-accordion__heading">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <dl class="faq-accordion__list" data-faq-list>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          {%- assign item_id = 'faq-answer-' | append: section.id | append: '-' | append: forloop.index -%}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <dt class="faq-item__question">
              <button
                class="faq-item__button"
                type="button"
                aria-expanded="false"
                aria-controls="{{ item_id }}"
                data-faq-trigger
              >
                <span class="faq-item__question-text">
                  {{- block.settings.question | default: 'Question goes here' -}}
                </span>
                <span class="faq-item__icon" aria-hidden="true">+</span>
              </button>
            </dt>
            <dd
              id="{{ item_id }}"
              class="faq-item__answer"
              hidden
              data-faq-answer
            >
              <div class="faq-item__answer-inner">
                {{- block.settings.answer | default: 'Answer goes here.' -}}
              </div>
            </dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>

  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq-accordion",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (eyebrow)",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What people ask before they join."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "info": "Leave blank to use the theme default (cream)."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "When will Otto be available?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Otto is in development now. Presale opens to the waitlist first — you'll receive timing and pricing before anyone else.</p>"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "When will OTTO be available?",
            "answer": "<p>Otto is in development now. Presale opens to the waitlist first — you'll receive timing and pricing before anyone else.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What makes Otto different from other American Mahjong sets?",
            "answer": "<p>Every Otto component was designed in the same conversation. Tiles, mat, racks, accessories — one palette, one material logic, one visual language. Most sets are assembled from separate sources. Otto wasn't.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does Otto follow standard NMJL rules?",
            "answer": "<p>Yes. Otto is a standard 160-piece American Mahjong set, fully compatible with the NMJL card and rules. The design is original. The game is exactly the same one you know.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is Little Table?",
            "answer": "<p>A children's tile game designed as a stepping stone toward Mahjong. Four suits, three levels, ages 4–12. Not simplified Mahjong — its own complete game, designed by Otto.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to know how to play Mahjong to buy Otto?",
            "answer": "<p>Not at all. Otto includes everything you need to learn and play. Reference cards, guides, and a design that makes the game approachable from your first draw.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What does Otto mean?",
            "answer": "<p>One Table. Three Others. The four seats at a Mahjong table — and the reason the game works.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
