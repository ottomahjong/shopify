<section
  class="brand-story section-padding"
  data-section-id="{{ section.id }}"
  aria-labelledby="brand-story-heading-{{ section.id }}"
  {%- if section.settings.bg_color != blank %}
    style="background-color: {{ section.settings.bg_color }};"
  {%- endif %}
>
  <div class="container">
    <div class="brand-story__layout">

      {%- comment -%} LEFT COLUMN — intro text + pillar cards {%- endcomment -%}
      <div class="brand-story__left">

        <div class="brand-story__intro reveal">
          {%- if section.settings.section_label != blank -%}
            <p class="section-label">{{ section.settings.section_label }}</p>
          {%- endif -%}

          <h2 id="brand-story-heading-{{ section.id }}" class="brand-story__heading">
            {{- section.settings.heading -}}
            {%- if section.settings.heading_italic != blank -%}
              <br><em>{{ section.settings.heading_italic }}</em>
            {%- endif -%}
          </h2>

          <div class="brand-story__body-text">
            {%- if section.settings.body_1 != blank -%}
              <p>{{ section.settings.body_1 }}</p>
            {%- endif -%}
            {%- if section.settings.body_2 != blank -%}
              <p>{{ section.settings.body_2 }}</p>
            {%- endif -%}
            {%- if section.settings.body_3 != blank -%}
              <p>{{ section.settings.body_3 }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="brand-story__pillars reveal-stagger">
          {%- for block in section.blocks -%}
            {%- if block.type == 'pillar' -%}
              {%- if block.settings.label != blank -%}
                <div class="brand-story__pillar" {{ block.shopify_attributes }}>
                  <p class="brand-story__pillar-label section-label">{{ block.settings.label }}</p>
                  {%- if block.settings.description != blank -%}
                    <p class="brand-story__pillar-desc">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>

      {%- comment -%} RIGHT COLUMN — numbered story blocks {%- endcomment -%}
      <div class="brand-story__right">
        {%- assign story_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'story_block' and block.settings.text != blank -%}
            {%- assign story_index = story_index | plus: 1 -%}
            <div
              class="brand-story__number-block brand-story__number-block--{{ block.settings.theme }} reveal"
              {{ block.shopify_attributes }}
            >
              <span class="brand-story__num-label" aria-hidden="true">
                {%- if story_index < 10 %}0{%- endif %}{{ story_index }}
              </span>
              <div class="brand-story__pull-text">
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (eyebrow)",
      "default": "The Story"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (Futura)",
      "default": "Some games pass time."
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic line (Cormorant, appended)",
      "default": "Mahjong commands it."
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body paragraph 1",
      "default": "The first time you sit at a Mahjong table, something shifts. The tiles demand your attention. The strategy requires your focus. The clack of the draw, the rhythm of the discard — it creates a container for presence that almost nothing else does."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body paragraph 2",
      "default": "Otto was built from that moment. Not to reinvent Mahjong — a game with deep Chinese roots and a century of American life doesn't need correcting — but to create objects worthy of how the game actually feels."
    },
    {
      "type": "textarea",
      "id": "body_3",
      "label": "Body paragraph 3",
      "default": "A set that belongs in your home. One that everyone at the table wants to be near. Not just the person who bought it."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "info": "Leave blank to use the theme default (warm white)."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "story_block",
      "name": "Story block",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "theme",
          "label": "Color theme",
          "options": [
            { "value": "walnut", "label": "Walnut" },
            { "value": "night",  "label": "Night Navy" }
          ],
          "default": "walnut"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Story",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "label": "One System",
            "description": "Tiles, mat, racks, and accessories designed together. Not sourced separately and assembled. The visual language is consistent because the design process was unified from the start."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "label": "Built to Play",
            "description": "Not a collector's piece. An object that earns its place through use, not display. Designed to be handled dozens of times per game — and to feel like it."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "label": "For the Whole Table",
            "description": "Not feminine. Not masculine. Designed for households — including the partner who ends up most competitive."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "label": "Honest Materials",
            "description": "Walnut. Linen. Acrylic. Nothing pretending to be something it isn't."
          }
        },
        {
          "type": "story_block",
          "settings": {
            "text": "Most sets are beautiful. But the tiles came from one place, the mat from another, the racks from a third. Otto was designed the other way: every component in the same conversation, so everything on the table looks like it belongs there.",
            "theme": "walnut"
          }
        },
        {
          "type": "story_block",
          "settings": {
            "text": "Mid-century modern isn't an aesthetic reference for Otto. It's a belief system: functional, democratic, built to last. Objects designed with the same intention as the room they live in — and the people around them.",
            "theme": "night"
          }
        }
      ]
    }
  ]
}
{% endschema %}
