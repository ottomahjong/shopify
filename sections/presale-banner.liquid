<section
  class="presale-banner section-padding"
  id="waitlist"
  data-section-id="{{ section.id }}"
  {%- if section.settings.heading != blank or section.settings.heading_italic != blank %}
    aria-labelledby="presale-heading-{{ section.id }}"
  {%- else %}
    aria-label="Waitlist"
  {%- endif %}
  {%- if section.settings.bg_color != blank %}
    style="background-color: {{ section.settings.bg_color }};"
  {%- endif %}
>
  <div class="container">
    <div class="presale-banner__inner">

      {%- if section.settings.section_label != blank -%}
        <p class="presale-banner__eyebrow">
          {{- section.settings.section_label -}}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.heading_italic != blank -%}
        <h2 id="presale-heading-{{ section.id }}" class="presale-banner__heading reveal">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_italic != blank -%}
            <br><em>{{ section.settings.heading_italic }}</em>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="presale-banner__body reveal">
          {{- section.settings.body -}}
        </p>
      {%- endif -%}

      <div class="presale-banner__form-wrap reveal">
        {%- assign form_id = 'waitlist-form-' | append: section.id -%}
        {%- assign error_id = 'presale-error-' | append: section.id -%}
        {%- form 'customer', id: form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter,waitlist">

          {%- if form.posted_successfully? -%}
            <p class="presale-banner__success" role="status">
              {{- section.settings.success_message -}}
            </p>
          {%- else -%}
            <div class="presale-banner__form">
              <label for="waitlist-email-{{ section.id }}" class="sr-only">
                {{ 'general.email' | t: default: 'Email address' }}
              </label>
              <input
                type="email"
                id="waitlist-email-{{ section.id }}"
                name="contact[email]"
                class="presale-banner__input"
                placeholder="{{ section.settings.email_placeholder }}"
                required
                autocomplete="email"
                {%- if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ error_id }}"{% endif -%}
              >
              <button
                type="submit"
                class="presale-banner__btn btn btn--walnut"
              >
                {{- section.settings.button_label -}}
              </button>
            </div>

            {%- if form.errors -%}
              <p id="{{ error_id }}" class="presale-banner__error" role="alert">
                {{ 'general.email_invalid' | t: default: 'Please enter a valid email address.' }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.note != blank -%}
          <p class="presale-banner__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waitlist / Presale",
  "tag": "section",
  "class": "section-presale-banner",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (eyebrow)",
      "default": "Reserve Your Place"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading line 1 (Futura)",
      "default": "Be first"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading line 2 (Cormorant italic)",
      "default": "to the table."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body paragraph",
      "default": "Otto is currently in development. Join the waitlist for early access, presale pricing, and updates as the collection takes shape."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Join Waitlist"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. We'll be in touch first."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note below form",
      "default": "No spam. No noise. Just Otto updates when they matter."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#163224"
    }
  ],
  "presets": [
    {
      "name": "Waitlist / Presale"
    }
  ]
}
{% endschema %}
