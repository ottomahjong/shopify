<div
  class="announcement-bar"
  data-section-id="{{ section.id }}"
  data-announcement-bar
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
  role="region"
  aria-label="Announcement"
>
  <div class="announcement-bar__inner container">
    <p class="announcement-bar__text">
      {{- section.settings.text -}}
      {%- if section.settings.link_url != blank and section.settings.link_text != blank -%}
        <a href="{{ section.settings.link_url }}" class="announcement-bar__link">{{ section.settings.link_text }}</a>
      {%- endif -%}
    </p>
    <button
      type="button"
      class="announcement-bar__close"
      aria-label="{{ 'general.close' | t }}"
      data-announcement-close
    >
      <span aria-hidden="true">×</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "div",
  "class": "announcement-bar-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Otto is currently in development — join the waitlist for early access and presale pricing."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Join the waitlist →"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#163224"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#D5A896"
    }
  ]
}
{% endschema %}
