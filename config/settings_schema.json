      {
        "type": "text",
        "id": "announcement_link_text",
        "label": "Announcement link text",
        "default": "Reserve yours →"
      },
      {
        "type": "color",
        "id": "announcement_bg",
        "label": "Announcement background",
        "default": "#163224"
